#!/usr/bin/env bash
set -euo pipefail

evidence=docs/alpha-1-evidence.json
test -f "$evidence"
test "${GITHUB_RUN_ATTEMPT:?}" = 1

promotion_sha="$(git rev-parse HEAD)"
candidate_sha="$(git rev-parse HEAD^)"
test "$(jq -r .contract_version "$evidence")" = 1
test "$(jq -r .candidate_sha "$evidence")" = "$candidate_sha"
test "$(git diff --name-status --no-renames "$candidate_sha" "$promotion_sha")" = $'A\tdocs/alpha-1-evidence.json'

gate_run_id="$(jq -er '.gate.run_id | tostring' "$evidence")"
gate_job_id="$(jq -er '.gate.job_id | tostring' "$evidence")"
gate_run_attempt="$(jq -er '.gate.run_attempt | tostring' "$evidence")"
gate_run_url="$(jq -er .gate.run_url "$evidence")"
gate_job_url="$(jq -er .gate.job_url "$evidence")"
artifact_id="$(jq -er '.artifact.id | tostring' "$evidence")"
artifact_digest="$(jq -er .artifact.digest "$evidence")"
[[ "$artifact_digest" =~ ^[0-9a-f]{64}$ ]]

gate_run="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$gate_run_id")"
test "$(jq -r .head_sha <<<"$gate_run")" = "$candidate_sha"
test "$(jq -r .event <<<"$gate_run")" = push
test "$gate_run_attempt" = 1
test "$(jq -r .run_attempt <<<"$gate_run")" = "$gate_run_attempt"
test "$(jq -r .html_url <<<"$gate_run")" = "$gate_run_url"
test "$(jq -r .conclusion <<<"$gate_run")" = success
workflow_id="$(jq -r .workflow_id <<<"$gate_run")"

candidate_runs="$(gh api --paginate --slurp \
  "repos/$GITHUB_REPOSITORY/actions/workflows/$workflow_id/runs?event=push&head_sha=$candidate_sha&per_page=100" \
  | jq -c --arg sha "$candidate_sha" '[.[].workflow_runs[] | select(.head_sha == $sha) | .id] | unique')"
test "$candidate_runs" = "[$gate_run_id]"

gate_jobs="$(gh api --paginate --slurp "repos/$GITHUB_REPOSITORY/actions/runs/$gate_run_id/jobs?per_page=100")"
gate_job="$(jq -cer --argjson id "$gate_job_id" \
  '[.[].jobs[] | select(.id == $id)] | if length == 1 then .[0] else error("gate job ID is not unique") end' \
  <<<"$gate_jobs")"
test "$(jq -r .name <<<"$gate_job")" = "Alpha 1 gate"
test "$(jq -r .conclusion <<<"$gate_job")" = success
test "$(jq -r .html_url <<<"$gate_job")" = "$gate_job_url"

run_artifacts="$(gh api --paginate --slurp \
  "repos/$GITHUB_REPOSITORY/actions/runs/$gate_run_id/artifacts?per_page=100")"
artifact_ids="$(jq -c '[.[].artifacts[] | select(.name == "alpha-1-reports") | .id] | unique' <<<"$run_artifacts")"
test "$artifact_ids" = "[$artifact_id]"
artifact="$(gh api "repos/$GITHUB_REPOSITORY/actions/artifacts/$artifact_id")"
test "$(jq -r .workflow_run.id <<<"$artifact")" = "$gate_run_id"
test "$(jq -r .name <<<"$artifact")" = alpha-1-reports
test "$(jq -r .expired <<<"$artifact")" = false
test "$(jq -r .digest <<<"$artifact")" = "sha256:$artifact_digest"

promotion_runs="$(gh api --paginate --slurp \
  "repos/$GITHUB_REPOSITORY/actions/workflows/$workflow_id/runs?event=push&head_sha=$promotion_sha&per_page=100" \
  | jq -c --arg sha "$promotion_sha" '[.[].workflow_runs[] | select(.head_sha == $sha) | .id] | unique')"
test "$promotion_runs" = "[$GITHUB_RUN_ID]"

download="$(mktemp -d)"
trap 'rm -rf -- "$download"' EXIT
gh run download "$gate_run_id" --repo "$GITHUB_REPOSITORY" \
  --name alpha-1-reports --dir "$download"
(cd "$download" && sha256sum --check SHA256SUMS)

acceptance="$download/acceptance.json"
benchmark="$download/benchmark.json"
acceptance_sha="$(jq -er .reports.acceptance_sha256 "$evidence")"
benchmark_sha="$(jq -er .reports.benchmark_sha256 "$evidence")"
[[ "$acceptance_sha" =~ ^[0-9a-f]{64}$ ]]
[[ "$benchmark_sha" =~ ^[0-9a-f]{64}$ ]]
test "$(sha256sum "$acceptance" | cut -d' ' -f1)" = "$acceptance_sha"
test "$(sha256sum "$benchmark" | cut -d' ' -f1)" = "$benchmark_sha"
existing_test_count="$(jq -er '.counts.existing_test_count | tostring' "$evidence")"
acceptance_case_count="$(jq -er '.counts.acceptance_case_count | tostring' "$evidence")"
test "$acceptance_case_count" = 186
test "$existing_test_count" = "$(jq -er '.poc_observed_count | tostring' "$acceptance")"
jq -e '
  .schema_version == 1
  and .contract_version == 1
  and .report_kind == "alpha_1_acceptance"
  and .binary.release_profile == true
  and .poc_expected_count == 94
  and .poc_observed_count >= .poc_expected_count
  and ((.poc_missing_ids | type) == "array" and (.poc_missing_ids | length) == 0)
  and .required_case_count == 186
  and ((.cases | type) == "array" and (.cases | length) == 186)
  and ([.cases[].id] | length == (unique | length))
  and all(.cases[]; (.id | type) == "string" and .passed == true)
  and .passed == 186
  and .failed == 0
  and .all_assertions_passed == true
' "$acceptance" >/dev/null
jq -e '
  .schema_version == 1
  and .contract_version == 1
  and .report_kind == "alpha_1_benchmark"
  and .binary.release_profile == true
  and ((.assertions | type) == "object" and (.assertions | length) > 0)
  and all(.assertions[]; . == true)
  and .all_assertions_passed == true
' "$benchmark" >/dev/null
test "$(jq -c .oracles "$benchmark")" = "$(jq -c .oracles "$acceptance")"
test "$(jq -r .binary.content_sha256 "$benchmark")" = \
  "$(jq -r .binary.content_sha256 "$acceptance")"
test "$(jq -r .oracles.generator_source_sha256 "$acceptance")" = "$(jq -er .oracle.generator_source_sha256 "$evidence")"
test "$(jq -r .oracles.spec_sha256 "$acceptance")" = "$(jq -er .oracle.spec_sha256 "$evidence")"
test "$(jq -r .oracles.before_manifest_sha256 "$acceptance")" = \
  "$(jq -er .oracle.before_manifest_sha256 "$evidence")"
test "$(jq -r .oracles.after_manifest_sha256 "$acceptance")" = \
  "$(jq -er .oracle.after_manifest_sha256 "$evidence")"

echo "Alpha 1 evidence verified for candidate $candidate_sha"
