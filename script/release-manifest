#!/usr/bin/env python3
"""Build and verify deterministic zec release metadata and updater manifests."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import re
import sys
import tarfile
import tempfile
import zipfile
from pathlib import Path
from urllib.parse import urlparse

SCHEMA = 1
VERSION = re.compile(r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?")
TARGET = re.compile(r"[a-z0-9_]+")
REPOSITORY = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
SHA256 = re.compile(r"[0-9a-f]{64}")


def fail(message: str) -> "None":
    raise ValueError(message)


def digest(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            value.update(block)
    return value.hexdigest()


def checked_file(path: Path) -> Path:
    if path.is_symlink():
        fail(f"symbolic links are not release inputs: {path}")
    path = path.resolve(strict=True)
    if not path.is_file():
        fail(f"not a regular file: {path}")
    return path


def checked_version(value: str) -> str:
    if not VERSION.fullmatch(value):
        fail(f"invalid release version: {value!r}")
    return value


def checked_target(value: str, label: str) -> str:
    if not TARGET.fullmatch(value):
        fail(f"invalid {label}: {value!r}")
    return value


def executable_name(target_os: str) -> str:
    return "zec.exe" if target_os == "windows" else "zec"


def raw_asset_name(target_os: str, arch: str) -> str:
    suffix = ".exe" if target_os == "windows" else ""
    return f"zec-{target_os}-{arch}{suffix}"


def archive_asset_name(target_os: str, arch: str) -> str:
    suffix = ".zip" if target_os == "windows" else ".tar.gz"
    return f"zec-{target_os}-{arch}{suffix}"


def remote_server_asset_name(target_os: str, arch: str) -> str:
    suffix = ".zip" if target_os == "windows" else ".gz"
    return f"zec-remote-server-{target_os}-{arch}{suffix}"


def write_json(path: Path, value: object) -> None:
    encoded = json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    path.write_text(encoded, encoding="utf-8", newline="\n")


def metadata(args: argparse.Namespace) -> None:
    version = checked_version(args.version)
    target_os = checked_target(args.os, "OS")
    arch = checked_target(args.arch, "architecture")
    asset = checked_file(args.asset)
    archive = checked_file(args.archive)
    remote_server = checked_file(args.remote_server)
    if asset.name != raw_asset_name(target_os, arch):
        fail(f"raw asset must be named {raw_asset_name(target_os, arch)!r}")
    if archive.name != archive_asset_name(target_os, arch):
        fail(f"archive must be named {archive_asset_name(target_os, arch)!r}")
    if remote_server.name != remote_server_asset_name(target_os, arch):
        fail(f"remote server must be named {remote_server_asset_name(target_os, arch)!r}")
    output = args.output.resolve()
    if output.exists():
        fail(f"refusing to overwrite metadata: {output}")
    write_json(
        output,
        {
            "schema_version": SCHEMA,
            "version": version,
            "os": target_os,
            "arch": arch,
            "asset": asset.name,
            "asset_sha256": digest(asset),
            "asset_size": asset.stat().st_size,
            "archive": archive.name,
            "archive_sha256": digest(archive),
            "archive_size": archive.stat().st_size,
            "remote_server": remote_server.name,
            "remote_server_sha256": digest(remote_server),
            "remote_server_size": remote_server.stat().st_size,
            "executable": executable_name(target_os),
        },
    )


def load_metadata(path: Path, version: str) -> dict[str, object]:
    value = json.loads(path.read_text(encoding="utf-8"))
    required = {
        "schema_version",
        "version",
        "os",
        "arch",
        "asset",
        "asset_sha256",
        "asset_size",
        "archive",
        "archive_sha256",
        "archive_size",
        "remote_server",
        "remote_server_sha256",
        "remote_server_size",
        "executable",
    }
    if not isinstance(value, dict) or set(value) != required:
        fail(f"invalid metadata fields: {path}")
    if value["schema_version"] != SCHEMA or value["version"] != version:
        fail(f"metadata schema/version mismatch: {path}")
    target_os = checked_target(str(value["os"]), "OS")
    arch = checked_target(str(value["arch"]), "architecture")
    if value["asset"] != raw_asset_name(target_os, arch):
        fail(f"metadata raw asset name mismatch: {path}")
    if value["archive"] != archive_asset_name(target_os, arch):
        fail(f"metadata archive name mismatch: {path}")
    if value["remote_server"] != remote_server_asset_name(target_os, arch):
        fail(f"metadata remote server name mismatch: {path}")
    if value["executable"] != executable_name(target_os):
        fail(f"metadata executable name mismatch: {path}")
    for key in ("asset_sha256", "archive_sha256", "remote_server_sha256"):
        if not isinstance(value[key], str) or not SHA256.fullmatch(value[key]):
            fail(f"invalid {key}: {path}")
    for key in ("asset_size", "archive_size", "remote_server_size"):
        if not isinstance(value[key], int) or not 0 < value[key] <= 512 * 1024 * 1024:
            fail(f"invalid {key}: {path}")
    return value


def distributable_files(directory: Path) -> list[Path]:
    return sorted(
        path
        for path in directory.iterdir()
        if path.is_file()
        and path.name.startswith("zec-")
        and not path.name.startswith("zec-release-metadata-")
        and path.name != "SHA256SUMS"
    )


def assemble(args: argparse.Namespace) -> None:
    directory = args.directory.resolve(strict=True)
    version = checked_version(args.version)
    repository = args.repository
    if not REPOSITORY.fullmatch(repository):
        fail(f"invalid GitHub repository: {repository!r}")
    metadata_paths = sorted(directory.glob("zec-release-metadata-*.json"))
    if not metadata_paths:
        fail("no release metadata found")
    records = [load_metadata(path, version) for path in metadata_paths]
    targets: set[tuple[str, str]] = set()
    assets: list[dict[str, object]] = []
    remote_servers: list[dict[str, object]] = []
    for record in records:
        key = (str(record["os"]), str(record["arch"]))
        if key in targets:
            fail(f"duplicate release target: {key[0]}/{key[1]}")
        targets.add(key)
        for name_key, hash_key, size_key in (
            ("asset", "asset_sha256", "asset_size"),
            ("archive", "archive_sha256", "archive_size"),
            ("remote_server", "remote_server_sha256", "remote_server_size"),
        ):
            path = checked_file(directory / str(record[name_key]))
            if path.stat().st_size != record[size_key] or digest(path) != record[hash_key]:
                fail(f"metadata does not match {path.name}")
        assets.append(
            {
                "os": record["os"],
                "arch": record["arch"],
                "url": f"https://github.com/{repository}/releases/download/v{version}/{record['asset']}",
                "sha256": record["asset_sha256"],
                "size": record["asset_size"],
                "executable": record["executable"],
            }
        )
        remote_servers.append(
            {
                "os": record["os"],
                "arch": record["arch"],
                "url": f"https://github.com/{repository}/releases/download/v{version}/{record['remote_server']}",
                "sha256": record["remote_server_sha256"],
                "size": record["remote_server_size"],
            }
        )
    assets.sort(key=lambda asset: (str(asset["os"]), str(asset["arch"])))
    remote_servers.sort(key=lambda asset: (str(asset["os"]), str(asset["arch"])))
    manifest_path = directory / "zec-update-v1.json"
    if manifest_path.exists():
        fail(f"refusing to overwrite manifest: {manifest_path}")
    write_json(
        manifest_path,
        {
            "schema_version": SCHEMA,
            "version": version,
            "release_url": f"https://github.com/{repository}/releases/tag/v{version}",
            "assets": assets,
            "remote_servers": remote_servers,
        },
    )
    sums = directory / "SHA256SUMS"
    if sums.exists():
        fail(f"refusing to overwrite checksums: {sums}")
    sums.write_text(
        "".join(f"{digest(path)}  {path.name}\n" for path in distributable_files(directory)),
        encoding="ascii",
        newline="\n",
    )
    verify_directory(directory, repository)


def archive_members(directory: Path, record: dict[str, object], version: str) -> tuple[bytes, bytes]:
    archive = directory / str(record["archive"])
    root = f"zec-{version}"
    executable = f"{root}/{record['executable']}"
    remote_server = f"{root}/{record['remote_server']}"
    required = {executable, remote_server, f"{root}/README.md", f"{root}/LICENSE"}
    if str(record["os"]) == "windows":
        with zipfile.ZipFile(archive) as value:
            names = {name.rstrip("/") for name in value.namelist() if not name.endswith("/")}
            if names != required:
                fail(f"unexpected archive members in {archive.name}: {sorted(names)}")
            return value.read(executable), value.read(remote_server)
    with tarfile.open(archive, "r:gz") as value:
        names = {member.name.rstrip("/") for member in value.getmembers() if member.isfile()}
        if names != required:
            fail(f"unexpected archive members in {archive.name}: {sorted(names)}")
        member = value.extractfile(executable)
        if member is None:
            fail(f"archive executable missing: {archive.name}")
        remote_member = value.extractfile(remote_server)
        if remote_member is None:
            fail(f"archive remote server missing: {archive.name}")
        return member.read(), remote_member.read()


def verify_directory(directory: Path, repository: str | None = None) -> None:
    manifest_path = checked_file(directory / "zec-update-v1.json")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if not isinstance(manifest, dict) or set(manifest) != {
        "schema_version",
        "version",
        "release_url",
        "assets",
        "remote_servers",
    }:
        fail("invalid update manifest fields")
    if manifest["schema_version"] != SCHEMA:
        fail("invalid update manifest schema")
    version = checked_version(str(manifest["version"]))
    release_url = urlparse(str(manifest["release_url"]))
    if release_url.scheme != "https" or release_url.netloc != "github.com":
        fail("release URL must use github.com HTTPS")
    if repository and manifest["release_url"] != f"https://github.com/{repository}/releases/tag/v{version}":
        fail("release URL does not match repository/version")

    metadata_paths = sorted(directory.glob("zec-release-metadata-*.json"))
    records = [load_metadata(path, version) for path in metadata_paths]
    expected_assets = {(str(record["os"]), str(record["arch"])): record for record in records}
    actual_targets: set[tuple[str, str]] = set()
    for asset in manifest["assets"]:
        if not isinstance(asset, dict) or set(asset) != {
            "os",
            "arch",
            "url",
            "sha256",
            "size",
            "executable",
        }:
            fail("invalid update asset fields")
        key = (str(asset["os"]), str(asset["arch"]))
        if key in actual_targets or key not in expected_assets:
            fail(f"duplicate or unknown update target: {key}")
        actual_targets.add(key)
        record = expected_assets[key]
        raw = checked_file(directory / str(record["asset"]))
        expected_url = f"https://github.com/{repository}/releases/download/v{version}/{raw.name}" if repository else None
        if expected_url and asset["url"] != expected_url:
            fail(f"update asset URL mismatch: {key}")
        if asset["sha256"] != digest(raw) or asset["size"] != raw.stat().st_size:
            fail(f"update asset digest/size mismatch: {key}")
        if asset["executable"] != record["executable"]:
            fail(f"update executable mismatch: {key}")
        archive_binary, archive_remote = archive_members(directory, record, version)
        if archive_binary != raw.read_bytes():
            fail(f"archive/raw binary mismatch: {key}")
        remote_server = checked_file(directory / str(record["remote_server"]))
        if archive_remote != remote_server.read_bytes():
            fail(f"archive/remote server mismatch: {key}")
    if actual_targets != set(expected_assets):
        fail("update manifest omits release targets")

    actual_remote_targets: set[tuple[str, str]] = set()
    for asset in manifest["remote_servers"]:
        if not isinstance(asset, dict) or set(asset) != {
            "os",
            "arch",
            "url",
            "sha256",
            "size",
        }:
            fail("invalid remote server asset fields")
        key = (str(asset["os"]), str(asset["arch"]))
        if key in actual_remote_targets or key not in expected_assets:
            fail(f"duplicate or unknown remote server target: {key}")
        actual_remote_targets.add(key)
        record = expected_assets[key]
        remote_server = checked_file(directory / str(record["remote_server"]))
        expected_url = (
            f"https://github.com/{repository}/releases/download/v{version}/{remote_server.name}"
            if repository
            else None
        )
        if expected_url and asset["url"] != expected_url:
            fail(f"remote server URL mismatch: {key}")
        if asset["sha256"] != digest(remote_server) or asset["size"] != remote_server.stat().st_size:
            fail(f"remote server digest/size mismatch: {key}")
    if actual_remote_targets != set(expected_assets):
        fail("update manifest omits remote server targets")

    checksum_lines = checked_file(directory / "SHA256SUMS").read_text(encoding="ascii").splitlines()
    checksums: dict[str, str] = {}
    for line in checksum_lines:
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9_.-]+)", line)
        if not match or match.group(2) in checksums:
            fail("invalid or duplicate SHA256SUMS line")
        checksums[match.group(2)] = match.group(1)
    files = {path.name: digest(path) for path in distributable_files(directory)}
    if checksums != files:
        fail("SHA256SUMS does not exactly cover distributable files")


def verify(args: argparse.Namespace) -> None:
    repository = args.repository
    if repository and not REPOSITORY.fullmatch(repository):
        fail(f"invalid GitHub repository: {repository!r}")
    verify_directory(args.directory.resolve(strict=True), repository)


def self_test(_args: argparse.Namespace) -> None:
    with tempfile.TemporaryDirectory(prefix="zec-release-manifest-") as temporary:
        directory = Path(temporary)
        version = "1.2.3"
        for target_os, arch in (("linux", "x86_64"), ("windows", "aarch64")):
            raw = directory / raw_asset_name(target_os, arch)
            raw.write_bytes(f"zec {version} {target_os} {arch}\n".encode())
            remote_server = directory / remote_server_asset_name(target_os, arch)
            remote_binary = f"remote {version} {target_os} {arch}\n".encode()
            if target_os == "windows":
                with zipfile.ZipFile(remote_server, "w", zipfile.ZIP_DEFLATED) as value:
                    value.writestr("remote_server.exe", remote_binary)
            else:
                import gzip

                remote_server.write_bytes(gzip.compress(remote_binary, mtime=0))
            archive = directory / archive_asset_name(target_os, arch)
            root = f"zec-{version}"
            if target_os == "windows":
                with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as value:
                    value.writestr(f"{root}/{executable_name(target_os)}", raw.read_bytes())
                    value.writestr(f"{root}/{remote_server.name}", remote_server.read_bytes())
                    value.writestr(f"{root}/README.md", b"readme\n")
                    value.writestr(f"{root}/LICENSE", b"license\n")
            else:
                with tarfile.open(archive, "w:gz") as value:
                    for name, content in (
                        (executable_name(target_os), raw.read_bytes()),
                        (remote_server.name, remote_server.read_bytes()),
                        ("README.md", b"readme\n"),
                        ("LICENSE", b"license\n"),
                    ):
                        info = tarfile.TarInfo(f"{root}/{name}")
                        info.size = len(content)
                        info.mode = 0o755 if name == executable_name(target_os) else 0o644
                        value.addfile(info, io.BytesIO(content))
            metadata(
                argparse.Namespace(
                    version=version,
                    os=target_os,
                    arch=arch,
                    asset=raw,
                    archive=archive,
                    remote_server=remote_server,
                    output=directory / f"zec-release-metadata-{target_os}-{arch}.json",
                )
            )
        assemble(argparse.Namespace(directory=directory, version=version, repository="neguse/zec"))
        verify_directory(directory, "neguse/zec")
        victim = directory / "zec-linux-x86_64"
        victim.write_bytes(victim.read_bytes() + b"tampered")
        try:
            verify_directory(directory, "neguse/zec")
        except ValueError:
            return
        fail("tampering was not detected")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser()
    commands = result.add_subparsers(dest="command", required=True)
    metadata_parser = commands.add_parser("metadata")
    metadata_parser.add_argument("--version", required=True)
    metadata_parser.add_argument("--os", required=True)
    metadata_parser.add_argument("--arch", required=True)
    metadata_parser.add_argument("--asset", type=Path, required=True)
    metadata_parser.add_argument("--archive", type=Path, required=True)
    metadata_parser.add_argument("--remote-server", type=Path, required=True)
    metadata_parser.add_argument("--output", type=Path, required=True)
    metadata_parser.set_defaults(run=metadata)
    assemble_parser = commands.add_parser("assemble")
    assemble_parser.add_argument("--directory", type=Path, required=True)
    assemble_parser.add_argument("--version", required=True)
    assemble_parser.add_argument("--repository", required=True)
    assemble_parser.set_defaults(run=assemble)
    verify_parser = commands.add_parser("verify")
    verify_parser.add_argument("--directory", type=Path, required=True)
    verify_parser.add_argument("--repository")
    verify_parser.set_defaults(run=verify)
    test_parser = commands.add_parser("self-test")
    test_parser.set_defaults(run=self_test)
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        args.run(args)
    except (OSError, ValueError, json.JSONDecodeError, tarfile.TarError, zipfile.BadZipFile) as error:
        print(f"release-manifest: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
