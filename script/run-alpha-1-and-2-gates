#!/usr/bin/env bash
set -euo pipefail

output_root="${1:?usage: run-alpha-1-and-2-gates OUTPUT_DIR}"
zec="${ZEC_E2E_ZEC:-./target/release/zec}"
lsp="${ZEC_E2E_FIXTURE_LSP:-./target/release/fixture_lsp}"
e2e_repository="${ZEC_E2E_REPOSITORY_ACCEPTANCE:-./target/release/e2e_repository}"
e2e_repository_bench="${ZEC_E2E_REPOSITORY_BENCH:-./target/release/e2e_repository_bench}"
e2e_language="${ZEC_E2E_LANGUAGE_ACCEPTANCE:-./target/release/e2e_language}"
e2e_language_bench="${ZEC_E2E_LANGUAGE_BENCH:-./target/release/e2e_language_bench}"

mkdir -p "$output_root/alpha-2/alpha-1"
artifact_root="$(realpath "$output_root/alpha-2")"

timeout --signal=TERM --kill-after=5s 45m \
  "$e2e_repository" --zec "$zec" --repo . --assert \
  --report "$artifact_root/alpha-1/acceptance.json"
"$e2e_repository" \
  --verify-report "$artifact_root/alpha-1/acceptance.json"

timeout --signal=TERM --kill-after=5s 20m \
  "$e2e_repository_bench" --zec "$zec" --assert \
  --report "$artifact_root/alpha-1/benchmark.json"
"$e2e_repository_bench" --verify-report "$artifact_root/alpha-1/benchmark.json"

timeout --signal=TERM --kill-after=5s 45m \
  "$e2e_language" --zec "$zec" --lsp "$lsp" --assert \
  --report "$artifact_root/acceptance.json"
"$e2e_language" --verify-report "$artifact_root/acceptance.json"

timeout --signal=TERM --kill-after=5s 20m \
  "$e2e_language_bench" --zec "$zec" --lsp "$lsp" --assert \
  --report "$artifact_root/benchmark.json"
"$e2e_language_bench" --verify-report "$artifact_root/benchmark.json"

(
  cd "$artifact_root"
  find . -type f ! -name SHA256SUMS -print0 \
    | sort -z \
    | xargs -0 sha256sum > SHA256SUMS
)
./script/verify-alpha-2-artifact "$artifact_root"

echo "Alpha 1/2 regression artifact verified: $artifact_root"
