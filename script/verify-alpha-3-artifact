#!/usr/bin/env bash
set -euo pipefail

artifact_root="$(realpath "${1:?usage: verify-alpha-3-artifact ARTIFACT_DIR [EVIDENCE_JSON]}")"
promoted_evidence="${2:-}"
test -z "$(find "$artifact_root" -type l -print -quit)"
(
  cd "$artifact_root"
  sha256sum --check SHA256SUMS
)

acceptance="$artifact_root/acceptance.json"
benchmark="$artifact_root/benchmark.json"
regression="$artifact_root/regression/alpha-2"
e2e_language="$regression/acceptance.json"
e2e_language_benchmark="$regression/benchmark.json"
e2e_repository="$regression/alpha-1/acceptance.json"
e2e_repository_benchmark="$regression/alpha-1/benchmark.json"
for report_path in \
  "$acceptance" "$benchmark" \
  "$e2e_language" "$e2e_language_benchmark" \
  "$e2e_repository" "$e2e_repository_benchmark"; do
  test -f "$report_path"
done
test "$(find "$artifact_root" -path "$regression" -prune -o -type f -print | wc -l)" = 10
./script/verify-alpha-2-artifact "$regression"

if [[ -n "$promoted_evidence" ]]; then
  test -f "$promoted_evidence"
  for report_name in \
    acceptance benchmark e2e_language e2e_language_benchmark \
    e2e_repository e2e_repository_benchmark; do
    report_path="${!report_name}"
    digest_key="${report_name}_sha256"
    expected_digest="$(jq -er --arg key "$digest_key" '.reports[$key]' "$promoted_evidence")"
    [[ "$expected_digest" =~ ^[0-9a-f]{64}$ ]]
    test "$(sha256sum "$report_path" | cut -d' ' -f1)" = "$expected_digest"
  done
fi

scratch="$(mktemp -d)"
trap 'rm -rf -- "$scratch"' EXIT
expected_ids="$scratch/expected-case-ids"
actual_ids="$scratch/actual-case-ids"
printf 'C1_WORKSPACE_MODEL\n' > "$expected_ids"
for prefix in \
  C2_LAYOUT C2_TABS C3_PROJECT_PANEL C4_SEARCH_REPLACE C5_NAV_OUTLINE \
  C6_ADVANCED_EDITOR C7_SESSION_RESTORE C7_CRASH_RECOVERY \
  C8_CAPABILITY_FALLBACK; do
  for run in $(seq -w 1 20); do
    printf '%s_%s\n' "$prefix" "$run"
  done
done >> "$expected_ids"
for scenario in \
  CORRUPT_TRUNCATED_SESSION PROJECT_PANEL_SYMLINK_ESCAPE \
  FILE_OPERATION_PERMISSION_DENIED DIRTY_DELETE_RENAME_CONFLICT \
  REPLACE_FINGERPRINT_CONFLICT TERMINAL_1X1_RESIZE_STORM \
  WATCHER_OVERFLOW_RESCAN_REORDER STALE_OUTLINE_PANEL_SEARCH_GENERATION \
  CRASH_DURING_RECOVERY_JOURNAL_COMMIT; do
  for run in $(seq -w 1 20); do
    printf 'C8_%s_%s\n' "$scenario" "$run"
  done
done >> "$expected_ids"
jq -r '.cases[].id' "$acceptance" > "$actual_ids"
cmp "$expected_ids" "$actual_ids"

jq -e '
  .schema_version == 1
  and .contract_version == 3
  and .report_kind == "e2e_workspace"
  and .binary.zec.release_profile == true
  and (.binary.zec.content_sha256 | test("^[0-9a-f]{64}$"))
  and .fresh_process_runs == 20
  and .capability_family_count == 9
  and .failure_scenario_count == 9
  and .required_case_count == 361
  and ((.cases | type) == "array" and (.cases | length) == 361)
  and ([.cases[].id] | length == (unique | length))
  and all(.cases[];
    (.id | type) == "string"
    and .passed == true
    and (.duration_us >= 0 and .duration_us <= 120000000)
    and (.detail | type) == "string" and (.detail | length) > 0)
  and .passed == 361
  and .failed == 0
  and (.correlation.request_ids == [.cases[].id])
  and (.correlation.response_ids == .correlation.request_ids)
  and (.correlation.input_ids == .correlation.request_ids)
  and (.correlation.apply_ids == .correlation.request_ids)
  and ((.evidence | type) == "array" and (.evidence | length) == 3)
  and ([.evidence[].label] | sort == [
    "event-trace.json", "manifest.json", "session-trace.json"
  ])
  and .all_assertions_passed == true
' "$acceptance" >/dev/null

jq -e '
  def nearest($values; $percent):
    ($values | sort) as $sorted
    | ((($percent * ($sorted | length) + 99) / 100 | floor) - 1) as $index
    | $sorted[$index];
  def metric($value; $warmups; $samples; $p95_limit; $max_limit):
    $value.warmups == $warmups
    and $value.expected_samples == $samples
    and (($value.raw_samples_us | type) == "array"
      and ($value.raw_samples_us | length) == $samples
      and all($value.raw_samples_us[]; type == "number" and . >= 0))
    and $value.p50_us == nearest($value.raw_samples_us; 50)
    and $value.p95_us == nearest($value.raw_samples_us; 95)
    and $value.max_us == ($value.raw_samples_us | max)
    and $value.p95_limit_us == $p95_limit
    and $value.max_limit_us == $max_limit
    and $value.p95_us <= $p95_limit
    and $value.max_us <= $max_limit
    and $value.assertion_passed == true;
  .schema_version == 1
  and .contract_version == 3
  and .report_kind == "e2e_workspace_benchmark"
  and .binary.zec.release_profile == true
  and (.binary.zec.content_sha256 | test("^[0-9a-f]{64}$"))
  and .workload == {
    "tree_files": 10000,
    "outline_symbols": 10000,
    "replace_files": 1000,
    "large_lines": 100000,
    "session_panes": 20
  }
  and metric(.four_pane_redraw; 10; 100; 16000; 50000)
  and metric(.project_panel_initial_ready; 0; 20; 750000; 1500000)
  and metric(.outline_update; 0; 100; 100000; 250000)
  and metric(.regex_first_visible_result; 0; 100; 150000; 500000)
  and metric(.replace_preview; 0; 20; 750000; 2000000)
  and metric(.navigation_apply; 10; 500; 16000; 50000)
  and metric(.session_restore; 0; 20; 1500000; 3000000)
  and .vm_hwm_limit_bytes == 1879048192
  and (.vm_hwm_bytes > 0 and .vm_hwm_bytes <= .vm_hwm_limit_bytes)
  and (.correlation.request_ids == .correlation.response_ids)
  and (.correlation.request_ids == .correlation.input_ids)
  and (.correlation.input_ids == .correlation.apply_ids)
  and ((.correlation.input_ids | length) == 860)
  and ([.correlation.input_ids[]] | length == (unique | length))
  and ((.evidence | type) == "array" and (.evidence | length) == 4)
  and ([.evidence[].label] | sort == [
    "latency-trace.json", "memory-observations.json",
    "session-generation.json", "workload-manifest.json"
  ])
  and (.assertions | keys == [
    "correlation", "four_pane_redraw_latency", "navigation_apply_latency",
    "outline_update_latency", "project_panel_initial_ready_latency",
    "regex_first_visible_result_latency", "replace_preview_latency",
    "session_restore_latency", "session_shape", "vm_hwm", "workload_unchanged"
  ])
  and all(.assertions[]; . == true)
  and .all_assertions_passed == true
' "$benchmark" >/dev/null

verify_embedded_evidence() {
  local report="$1"
  local directory="$2"
  local expected_count="$3"
  local observed=0
  while IFS=$'\t' read -r label bytes digest reported_path; do
    [[ "$label" != */* && "$label" != . && "$label" != .. ]]
    test "${reported_path##*/}" = "$label"
    case "$reported_path" in
      */"$directory"/"$label") ;;
      *) return 1 ;;
    esac
    local artifact_file="$artifact_root/$directory/$label"
    test -f "$artifact_file"
    test "$(stat -c %s "$artifact_file")" = "$bytes"
    test "$(sha256sum "$artifact_file" | cut -d' ' -f1)" = "$digest"
    case "$artifact_file" in
      *.json) jq -e . "$artifact_file" >/dev/null ;;
      *.jsonl) jq -e . "$artifact_file" >/dev/null ;;
    esac
    observed="$((observed + 1))"
  done < <(jq -r '.evidence[] | [.label, (.bytes | tostring), .sha256, .path] | @tsv' "$report")
  test "$observed" = "$expected_count"
}

verify_embedded_evidence "$acceptance" acceptance-artifacts 3
verify_embedded_evidence "$benchmark" benchmark-artifacts 4

zec_digest="$(jq -r .binary.zec.content_sha256 "$acceptance")"
test "$(jq -r .binary.zec.content_sha256 "$benchmark")" = "$zec_digest"
test "$(jq -r .binaries.zec.content_sha256 "$e2e_language")" = "$zec_digest"
test "$(jq -r .binaries.zec.content_sha256 "$e2e_language_benchmark")" = "$zec_digest"
test "$(jq -r .binary.content_sha256 "$e2e_repository")" = "$zec_digest"
test "$(jq -r .binary.content_sha256 "$e2e_repository_benchmark")" = "$zec_digest"

echo "Alpha 3 artifact verified: $artifact_root"
