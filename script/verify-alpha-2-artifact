#!/usr/bin/env bash
set -euo pipefail

artifact_root="$(realpath "${1:?usage: verify-alpha-2-artifact ARTIFACT_DIR [EVIDENCE_JSON]}")"
promoted_evidence="${2:-}"
(cd "$artifact_root" && sha256sum --check SHA256SUMS)
test "$(find "$artifact_root" -type f | wc -l)" = 44

acceptance="$artifact_root/acceptance.json"
benchmark="$artifact_root/benchmark.json"
alpha_1_acceptance="$artifact_root/alpha-1/acceptance.json"
alpha_1_benchmark="$artifact_root/alpha-1/benchmark.json"
for report_path in \
  "$acceptance" "$benchmark" "$alpha_1_acceptance" "$alpha_1_benchmark"; do
  test -f "$report_path"
done

if [[ -n "$promoted_evidence" ]]; then
  test -f "$promoted_evidence"
  for report_name in \
    acceptance benchmark alpha_1_acceptance alpha_1_benchmark; do
    report_path="${!report_name}"
    digest_key="${report_name}_sha256"
    expected_digest="$(jq -er --arg key "$digest_key" '.reports[$key]' "$promoted_evidence")"
    [[ "$expected_digest" =~ ^[0-9a-f]{64}$ ]]
    test "$(sha256sum "$report_path" | cut -d' ' -f1)" = "$expected_digest"
  done
fi

scratch="$(mktemp -d)"
trap 'rm -rf -- "$scratch"' EXIT
expected_ids="$scratch/expected-case-ids"
actual_ids="$scratch/actual-case-ids"
for run in $(seq -w 1 20); do
  printf 'B1_B5_LANGUAGE_%s\n' "$run"
done >"$expected_ids"
printf 'B2_SETTINGS_RELOAD\n' >>"$expected_ids"
for run in $(seq -w 1 20); do
  printf 'B3_B6_B7_PTY_%s\n' "$run"
done >>"$expected_ids"
for scenario in \
  SERVER_NOT_FOUND SPAWN_FAILURE INITIALIZE_ERROR MALFORMED_FRAME \
  UNEXPECTED_EOF CRASH HANG_INITIALIZE REQUEST_ERROR MALFORMED_RESPONSE \
  CRASH_REQUEST HANG_REQUEST RESTART_ONCE FORMATTER_ERROR LARGE_PAYLOADS \
  HUGE_STDERR; do
  for run in $(seq -w 1 20); do
    printf 'B7_%s_%s\n' "$scenario" "$run"
  done
done >>"$expected_ids"
jq -r '.cases[].id' "$acceptance" >"$actual_ids"
cmp "$expected_ids" "$actual_ids"

jq -e '
  .schema_version == 1
  and .contract_version == 2
  and .report_kind == "alpha_2_acceptance"
  and .binaries.zec.release_profile == true
  and .binaries.fixture_lsp.release_profile == true
  and (.binaries.zec.content_sha256 | test("^[0-9a-f]{64}$"))
  and (.binaries.fixture_lsp.content_sha256 | test("^[0-9a-f]{64}$"))
  and .fresh_process_runs == 20
  and .failure_scenario_count == 15
  and .required_case_count == 341
  and ((.cases | type) == "array" and (.cases | length) == 341)
  and ([.cases[].id] | length == (unique | length))
  and all(.cases[];
    (.id | type) == "string"
    and .passed == true
    and (.duration_us >= 0 and .duration_us <= 120000000)
    and (.detail | type) == "string" and (.detail | length) > 0)
  and .passed == 341
  and .failed == 0
  and ((.evidence | type) == "array" and (.evidence | length) == 34)
  and ([.evidence[].label] | length == (unique | length))
  and all(.evidence[];
    (.label | type) == "string" and (.label | length) > 0
    and (.bytes | type) == "number" and .bytes > 0
    and (.sha256 | test("^[0-9a-f]{64}$")))
  and .all_assertions_passed == true
' "$acceptance" >/dev/null

jq -e '
  def nearest($values; $percent):
    ($values | sort) as $sorted
    | ((($percent * ($sorted | length) + 99) / 100 | floor) - 1) as $index
    | $sorted[$index];
  def metric($value; $warmups; $samples; $p95_limit; $max_limit):
    $value.warmups == $warmups
    and $value.expected_samples == $samples
    and (($value.raw_samples_us | type) == "array"
      and ($value.raw_samples_us | length) == $samples
      and all($value.raw_samples_us[]; type == "number" and . >= 0))
    and $value.p50_us == nearest($value.raw_samples_us; 50)
    and $value.p95_us == nearest($value.raw_samples_us; 95)
    and $value.max_us == ($value.raw_samples_us | max)
    and $value.p95_limit_us == $p95_limit
    and $value.max_limit_us == $max_limit
    and ($p95_limit == null or $value.p95_us <= $p95_limit)
    and ($max_limit == null or $value.max_us <= $max_limit)
    and $value.assertion_passed == true;
  .schema_version == 1
  and .contract_version == 2
  and .report_kind == "alpha_2_benchmark"
  and .binaries.zec.release_profile == true
  and .binaries.fixture_lsp.release_profile == true
  and metric(.startup; 2; 20; 3000000; null)
  and metric(.language_ready; 0; 20; 1500000; 3000000)
  and metric(.completion; 10; 100; 100000; 250000)
  and metric(.diagnostics; 0; 100; 100000; 250000)
  and metric(.definition; 0; 100; 150000; 500000)
  and metric(.references; 0; 100; 150000; 500000)
  and metric(.rename_apply_save; 0; 20; 500000; 1500000)
  and .vm_hwm_limit_bytes == 1610612736
  and (.vm_hwm_bytes > 0 and .vm_hwm_bytes <= .vm_hwm_limit_bytes)
  and (.correlation.request_ids == .correlation.response_ids)
  and (.correlation.input_ids == .correlation.apply_ids)
  and ((.correlation.request_ids | length) > 0)
  and ((.correlation.input_ids | length) == 420)
  and ([.correlation.request_ids[]] | length == (unique | length))
  and ([.correlation.input_ids[]] | length == (unique | length))
  and ((.evidence | type) == "array" and (.evidence | length) == 5)
  and ([.evidence[].label] | length == (unique | length))
  and (.assertions | keys) == [
    "completion_latency", "correlation", "definition_latency",
    "diagnostics_latency", "language_ready_latency", "references_latency",
    "rename_apply_save_latency", "startup_latency", "vm_hwm"
  ]
  and all(.assertions[]; . == true)
  and .all_assertions_passed == true
' "$benchmark" >/dev/null

jq -e '
  .schema_version == 1
  and .contract_version == 1
  and .report_kind == "alpha_1_acceptance"
  and .binary.release_profile == true
  and .poc_expected_count == 94
  and .poc_observed_count >= .poc_expected_count
  and ((.poc_missing_ids | type) == "array" and (.poc_missing_ids | length) == 0)
  and .required_case_count == 186
  and ((.cases | type) == "array" and (.cases | length) == 186)
  and ([.cases[].id] | length == (unique | length))
  and all(.cases[]; (.id | type) == "string" and .passed == true)
  and .passed == 186
  and .failed == 0
  and .all_assertions_passed == true
' "$alpha_1_acceptance" >/dev/null
jq -e '
  .schema_version == 1
  and .contract_version == 1
  and .report_kind == "alpha_1_benchmark"
  and .binary.release_profile == true
  and ((.assertions | type) == "object" and (.assertions | length) > 0)
  and all(.assertions[]; . == true)
  and .all_assertions_passed == true
' "$alpha_1_benchmark" >/dev/null

test "$(jq -c .oracles "$alpha_1_benchmark")" = "$(jq -c .oracles "$alpha_1_acceptance")"
zec_digest="$(jq -r .binary.content_sha256 "$alpha_1_acceptance")"
test "$(jq -r .binary.content_sha256 "$alpha_1_benchmark")" = "$zec_digest"
test "$(jq -r .binaries.zec.content_sha256 "$acceptance")" = "$zec_digest"
test "$(jq -r .binaries.zec.content_sha256 "$benchmark")" = "$zec_digest"
test "$(jq -r .binaries.fixture_lsp.content_sha256 "$acceptance")" = \
  "$(jq -r .binaries.fixture_lsp.content_sha256 "$benchmark")"

verify_embedded_evidence() {
  local report="$1"
  local directory="$2"
  local expected_count="$3"
  local observed=0
  while IFS=$'\t' read -r label bytes digest reported_path; do
    [[ "$label" != */* && "$label" != . && "$label" != .. ]]
    test "${reported_path##*/}" = "$label"
    case "$reported_path" in
      */"$directory"/"$label") ;;
      *) return 1 ;;
    esac
    local artifact_file="$artifact_root/$directory/$label"
    test -f "$artifact_file"
    test "$(stat -c %s "$artifact_file")" = "$bytes"
    test "$(sha256sum "$artifact_file" | cut -d' ' -f1)" = "$digest"
    case "$artifact_file" in
      *.json) jq -e . "$artifact_file" >/dev/null ;;
      *.jsonl) jq -e . "$artifact_file" >/dev/null ;;
    esac
    observed="$((observed + 1))"
  done < <(jq -r '.evidence[] | [.label, (.bytes | tostring), .sha256, .path] | @tsv' "$report")
  test "$observed" = "$expected_count"
}

verify_embedded_evidence "$acceptance" acceptance-artifacts 34
verify_embedded_evidence "$benchmark" benchmark-artifacts 5
echo "Alpha 2 artifact verified: $artifact_root"
